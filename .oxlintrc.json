{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react", "import", "jsx-a11y", "oxc"],
	"settings": {
		"react": {
			"version": "19.2.0"
		},
		"tailwindcss": {
			"callees": ["clsx", "cva", "cn"]
		}
	},
	"ignorePatterns": ["**/.content-collections/**", "**/routeTree.gen.ts"],
	"rules": {
		"no-restricted-imports": [
			"error",
			{
				"paths": [
					{
						"name": "@content-collections/mdx/react",
						"message": "The MDX runtime evaluates code with `new Function`, which the Workers runtime refuses: the page renders empty on the server. Compile content to HTML at build time (`compileMarkdown` from @content-collections/markdown) and render that."
					}
				]
			}
		]
	},
	"options": {
		"typeAware": true,
		"typeCheck": true
	},
	"overrides": [
		{
			"files": ["apps/relay/**", "packages/relay/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"@repo/**",
									"!@repo/ui",
									"!@repo/ui/**",
									"!@repo/utils",
									"!@repo/utils/**",
									"!@repo/i18n",
									"!@repo/i18n/**",
									"!@repo/logs",
									"!@repo/logs/**",
									"!@repo/relay",
									"!@repo/relay/**",
									"**/packages/**"
								],
								"message": "Relay depends only on @repo/ui, @repo/utils, @repo/i18n and @repo/logs (docs/relay/architecture.md \u00a74.3)."
							}
						]
					}
				]
			}
		}
	]
}
