{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vesact-marketing",
	"account_id": "6a8e5373d12070c930f09f1a82541a0b",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./server.ts",
	"observability": { "enabled": true },
	// No production Worker: production is the Docker target (AGENTS.md).
	"workers_dev": false,
	"env": {
		"preview": {
			"workers_dev": false,
			"observability": { "enabled": true },
			"routes": [{ "pattern": "www.preview.vesact.com", "custom_domain": true }],
		},
	},
}
