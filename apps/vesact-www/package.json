{
	"name": "vesact-www",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"generate": "content-collections build",
		"build": "pnpm generate && vite build",
		"start": "wrangler dev --port 3006",
		"clean": "git clean -xdf .cache .turbo dist node_modules .output .content-collections",
		"e2e": "pnpm exec playwright test --ui",
		"e2e:ci": "pnpm exec playwright install && pnpm exec playwright test",
		"type-check": "content-collections build && tsc --noEmit",
		"lint": "oxlint",
		"format": "oxfmt"
	},
	"dependencies": {
		"@content-collections/markdown": "^0.1.4",
		"@fontsource/noto-serif-sc": "^5.3.0",
		"@repo/analytics": "workspace:*",
		"@repo/i18n": "workspace:*",
		"@repo/ui": "workspace:*",
		"@repo/utils": "workspace:*",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-start": "catalog:",
		"lucide-react": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"use-intl": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "catalog:",
		"@content-collections/cli": "^0.1.9",
		"@content-collections/core": "^0.15.2",
		"@content-collections/vite": "^0.3.0",
		"@playwright/test": "catalog:",
		"@repo/tailwind-config": "workspace:*",
		"@repo/tsconfig": "workspace:*",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"dotenv": "catalog:",
		"shadcn": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wrangler": "catalog:"
	}
}
