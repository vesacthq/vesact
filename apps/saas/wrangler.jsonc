{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vesact-saas",
	"account_id": "6a8e5373d12070c930f09f1a82541a0b",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./server.ts",
	"observability": { "enabled": true },
	"routes": [{ "pattern": "www.vesact.com/studio*", "zone_name": "vesact.com" }],
	"vars": {
		"VITE_SAAS_URL": "https://www.vesact.com/studio",
		"VITE_MARKETING_URL": "https://www.vesact.com",
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "44e2ab6c84854ade9fe521c963bb55f9",
			"localConnectionString": "postgresql://postgres:postgres@localhost:5433/vesact",
		},
	],
}
